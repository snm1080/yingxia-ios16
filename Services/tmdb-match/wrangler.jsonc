// Configure the placeholder deployment resources for your Cloudflare account before deployment.
// Matches source videos to TMDB for the app's detail page (Sources/TVCore/TMDBMatch.swift). See README.md.
// Deploy: ../../website/node_modules/.bin/wrangler deploy (from this folder).
{
  "$schema": "../../website/node_modules/wrangler/config-schema.json",
  "name": "yingxia-tmdb",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "routes": [{ "pattern": "tmdb.example.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Model calls go out from the US (the retained GeminiRelay in src/index.ts serves both providers).
  "durable_objects": { "bindings": [{ "name": "GEMINI_RELAY", "class_name": "GeminiRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GeminiRelay"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "yingxia-tmdb", "database_id": "00000000-0000-0000-0000-000000000000" }],
  // Per IP address, in memory only. Each viewer opens a title once; a run is a few model turns.
  "ratelimits": [
    { "name": "MATCH_LIMITER", "namespace_id": "YOUR_MATCH_LIMITER_NAMESPACE_ID", "simple": { "limit": 20, "period": 60 } },
    { "name": "DETAILS_LIMITER", "namespace_id": "YOUR_DETAILS_LIMITER_NAMESPACE_ID", "simple": { "limit": 60, "period": 60 } },
    { "name": "CATALOG_SEARCH_LIMITER", "namespace_id": "YOUR_CATALOG_SEARCH_LIMITER_NAMESPACE_ID", "simple": { "limit": 120, "period": 60 } }
  ],
  // Secrets: OPENAI_API_KEY, GEMINI_API_KEY (retained for switching back), TMDB_TOKEN (wrangler secret put).
  "vars": { "AI_PROVIDER": "openai", "OPENAI_MODEL": "gpt-6-luna", "GEMINI_MODEL": "gemini-3.5-flash-lite", "DAILY_RUNS": "2000" },
  // Daily: drop expired answers.
  "triggers": { "crons": ["41 3 * * *"] },
  "observability": { "enabled": false }
}
